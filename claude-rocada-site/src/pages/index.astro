---
import { withBase } from '../lib/url';
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import CoachCard from '../components/CoachCard.astro';
import { site } from '../config/site';
import { t } from '../i18n';
import { isArchived } from '../lib/archive.mjs';
import { photo } from '../lib/images';

const s = t();
const now = new Date();
const home = (await getEntry('home', 'prima-pagina'))!;
const { Content } = await render(home);
const news = (await getCollection('news'))
  .filter((n) => !isArchived(n.data.date, now, site.archiveYears))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const coaches = (await getCollection('coaches')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const performances = (await getCollection('performances'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const galleries = (await getCollection('galleries')).sort((a, b) => b.data.year - a.data.year).slice(0, 3);
const hero = photo('photo_56.jpg')!;
---

<Base title={site.name} description={`${site.name} — ${site.tagline}. ${home.data.lead}`}>
  <section class="hero on-band">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__eyebrow">{home.data.eyebrow}</p>
        <h1 class="hero__title">{home.data.title}</h1>
        <p class="hero__lead">{home.data.lead}</p>
        <div class="btn-row">
          <a class="btn btn--band" href={site.enrollmentUrl} rel="noopener">{s.nav.enroll}</a>
          <a class="btn btn--outline-band" href={withBase('/despre-noi/')}>{s.nav.about}</a>
        </div>
      </div>
      <figure class="hero__figure">
        <Image src={hero} alt="Copiii și părinții clubului la cantonamentul ACS Smart Galați 2024, la Bran" width={880} height={660} loading="eager" fetchpriority="high" densities={[1, 1.5]} />
        <figcaption>Cantonamentul clubului, Bran 2024</figcaption>
      </figure>
    </div>
  </section>

  <section class="section pillars">
    <div class="wrap">
      <ul class="pillars__list">
        {home.data.pillars.map((p) => (
          <li class="pillar">
            <span class="pillar__piece" aria-hidden="true">{p.piece}</span>
            <h2>{p.title}</h2>
            <p>{p.text}</p>
            <a href={withBase(p.href)}>{p.link_text} →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <h2>{s.home.latestNews}</h2>
        <a class="more" href={withBase('/noutati/')}>{s.home.allNews} →</a>
      </div>
      <div class="grid grid--wide">
        {news.map((n) => <NewsCard entry={n} now={now} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap story">
      <div class="story__text prose">
        <p class="eyebrow">{s.nav.about}</p>
        <Content />
        <a class="btn btn--ghost" href={withBase('/despre-noi/')}>{s.nav.about}</a>
      </div>
      <div class="story__results">
        <div class="section-head">
          <h2>{s.home.performances}</h2>
        </div>
        <ol class="results">
          {performances.map((p) => (
            <li>
              <span class="results__year">{p.data.year}</span>
              <span class="results__body">
                <strong>{p.data.result}</strong>
                <span>{p.data.title}</span>
              </span>
            </li>
          ))}
        </ol>
        <a class="more" href={withBase('/performante/')}>{s.home.allPerformances} →</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <h2>{s.home.coaches}</h2>
        <a class="more" href={withBase('/antrenori/')}>{s.home.allCoaches} →</a>
      </div>
      <div class="grid">
        {coaches.map((c) => <CoachCard coach={c} compact />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>{s.home.gallery}</h2>
        <a class="more" href={withBase('/galerie/')}>{s.home.allGallery} →</a>
      </div>
      <div class="grid">
        {galleries.map((g) => (
          <a class="album" href={withBase(`/galerie/${g.id}/`)}>
            <Image src={photo(g.data.cover_image)!} alt="" width={640} height={480} loading="lazy" />
            <span class="album__label"><strong>{g.data.title}</strong><span>{g.data.year}{g.data.location ? ` · ${g.data.location}` : ''}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section support on-band">
    <div class="wrap support__inner">
      <div>
        <p class="eyebrow support__eyebrow">{s.nav.support}</p>
        <h2>{home.data.support_title}</h2>
        <p class="support__text">{home.data.support_text}</p>
        <div class="btn-row">
          <a class="btn btn--band" href={withBase('/sustine/')}>{s.home.supportCta}</a>
          <a class="btn btn--outline-band" href={withBase('/contact/')}>{s.home.contactCta}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--c-band);
    color: var(--c-band-text);
    padding-block: var(--s-8);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(rgba(255, 255, 255, 0.05) 0 25%, transparent 0 50%) 0 0 / 4rem 4rem;
    mask-image: linear-gradient(to right, transparent 55%, black);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--s-7);
    align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .hero__eyebrow {
    color: var(--c-band-accent);
  }
  .hero__title {
    color: #ffffff;
    font-size: var(--fs-hero);
    font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 1;
  }
  .hero__lead {
    font-size: var(--fs-lg);
    color: var(--c-band-muted);
    max-width: 52ch;
    margin-bottom: var(--s-6);
  }
  .hero__figure {
    margin: 0;
  }
  .hero__figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7);
    border: 4px solid rgba(255, 255, 255, 0.12);
  }
  .hero__figure figcaption {
    margin-top: var(--s-3);
    font-size: var(--fs-sm);
    color: var(--c-band-muted);
  }
  :global(.btn--outline-band) {
    background: transparent;
    border-color: var(--c-band-text);
    color: var(--c-band-text);
  }
  :global(.btn--outline-band:hover) {
    background: var(--c-band-text);
    color: var(--c-band);
    border-color: var(--c-band-text);
  }
  .pillars__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .pillar {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-top: 5px solid var(--c-accent);
    border-radius: var(--r-md);
    padding: var(--s-5);
    box-shadow: var(--c-shadow);
  }
  .pillar__piece {
    font-size: 2.5rem;
    line-height: 1;
    color: var(--c-primary);
    display: block;
    margin-bottom: var(--s-3);
  }
  .pillar h2 {
    font-size: var(--fs-h3);
  }
  .pillar a {
    font-weight: var(--fw-strong);
  }
  .story {
    display: grid;
    gap: var(--s-7);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }
  .results {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .results li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--s-3);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--c-border);
  }
  .results__year {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--c-accent-text);
  }
  .results__body {
    display: grid;
    gap: 0.15rem;
  }
  .results__body span {
    color: var(--c-text-2);
    font-size: var(--fs-sm);
  }
  .more {
    font-weight: var(--fw-strong);
  }
  .album {
    position: relative;
    display: block;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--c-border);
    text-decoration: none;
    color: var(--c-text);
    background: var(--c-surface);
  }
  .album img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .album__label {
    display: grid;
    gap: 0.15rem;
    padding: var(--s-4);
  }
  .album__label span {
    color: var(--c-text-2);
    font-size: var(--fs-sm);
  }
  .album:hover strong {
    text-decoration: underline;
  }
  .support {
    background: var(--c-band-2);
    color: var(--c-band-text);
  }
  .support h2 {
    color: #ffffff;
    max-width: 24ch;
  }
  .support__eyebrow {
    color: var(--c-band-accent);
  }
  .support__text {
    color: var(--c-band-muted);
    max-width: 60ch;
    font-size: var(--fs-lg);
    margin-bottom: var(--s-6);
  }
</style>
