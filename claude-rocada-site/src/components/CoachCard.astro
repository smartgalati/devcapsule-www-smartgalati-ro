---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { coachPhoto } from '../lib/images';
import { t } from '../i18n';
interface Props {
  coach: CollectionEntry<'coaches'>;
  compact?: boolean;
}
const { coach, compact = false } = Astro.props;
const s = t();
const photo = coachPhoto(coach.data.photo);
const href = withBase(`/antrenori/#${coach.id}`);
---

<article class="coach card">
  {photo ? (
    <Image class="coach__img" src={photo} alt={`Portret: ${coach.data.name}`} width={480} height={600} loading="lazy" densities={[1, 1.5]} />
  ) : (
    <div class="coach__img coach__img--empty" aria-hidden="true">♞</div>
  )}
  <div class="card__body">
    <h3>{compact ? <a href={href}>{coach.data.name}</a> : coach.data.name}</h3>
    <p class="coach__role">{coach.data.role}</p>
    {(coach.data.title || coach.data.rating) && (
      <p class="meta">
        {coach.data.title && <span class="chip">{coach.data.title}</span>}
        {coach.data.rating && <span>{s.coaches.rating}: <strong>{coach.data.rating}</strong></span>}
      </p>
    )}
    <slot />
  </div>
</article>

<style>
  .coach__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
  }
  .coach__img--empty {
    display: grid;
    place-items: center;
    font-size: 4rem;
    background: var(--c-surface-2);
    color: var(--c-text-2);
  }
  .coach__role {
    margin: 0;
    color: var(--c-text-2);
    font-weight: var(--fw-strong);
  }
  h3 a {
    color: inherit;
  }
</style>
