---
import { withBase } from '../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { site } from '../../config/site';
import { isArchived, newsPath, cutoffTimestamp } from '../../lib/archive.mjs';
import { formatDate, t } from '../../i18n';
const s = t();
const now = new Date();
const archived = (await getCollection('news'))
  .filter((n) => isArchived(n.data.date, now, site.archiveYears))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const byYear = new Map<number, typeof archived>();
for (const n of archived) {
  const y = n.data.date.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), n]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const cutoff = new Date(cutoffTimestamp(now, site.archiveYears));
---

<Base title={s.archive.title} description={s.archive.intro}>
  <PageHead title={s.archive.title} subtitle={s.archive.intro}>
    <p class="meta">Articole publicate înainte de {formatDate(cutoff)} · {s.archive.count(archived.length)}</p>
  </PageHead>
  <section class="section">
    <div class="wrap archive">
      <nav class="archive__years" aria-label={s.archive.yearsLabel}>
        <ul>
          {years.map((y) => (
            <li><a href={withBase(`/arhiva/${y}/`)}>{y} <span>{s.archive.count(byYear.get(y)!.length)}</span></a></li>
          ))}
        </ul>
      </nav>
      <div class="archive__list">
        {years.map((y) => (
          <section class="archive__year" id={`an-${y}`}>
            <h2><a href={withBase(`/arhiva/${y}/`)}>{s.archive.year(y)}</a></h2>
            <ul>
              {byYear.get(y)!.map((n) => (
                <li>
                  <time datetime={n.data.date.toISOString().slice(0, 10)}>{formatDate(n.data.date, 'ro', { day: 'numeric', month: 'short' })}</time>
                  <a href={withBase(newsPath(n.id, n.data.date, now, site.archiveYears))}>{n.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .archive {
    display: grid;
    gap: var(--s-7);
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    align-items: start;
  }
  .archive__years {
    position: sticky;
    top: var(--s-4);
  }
  .archive__years ul,
  .archive__year ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .archive__years a {
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    padding: 0.45rem 0.5rem;
    border-radius: var(--r-sm);
    font-weight: var(--fw-strong);
    text-decoration: none;
    color: var(--c-heading);
  }
  .archive__years a span {
    color: var(--c-text-2);
    font-weight: 400;
    font-size: var(--fs-sm);
  }
  .archive__years a:hover {
    background: var(--c-surface-2);
  }
  .archive__year {
    margin-bottom: var(--s-6);
    scroll-margin-top: var(--s-4);
  }
  .archive__year h2 {
    font-size: var(--fs-h3);
    border-bottom: 2px solid var(--c-accent);
    padding-bottom: var(--s-2);
  }
  .archive__year h2 a {
    color: inherit;
    text-decoration: none;
  }
  .archive__year li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--s-3);
    padding: var(--s-2) 0;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--c-border);
  }
  .archive__year time {
    color: var(--c-text-2);
    font-size: var(--fs-sm);
    padding-top: 0.15rem;
  }
  @media (max-width: 48rem) {
    .archive {
      grid-template-columns: minmax(0, 1fr);
    }
    .archive__years {
      position: static;
    }
    .archive__years ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
    }
    .archive__years a {
      border: 1px solid var(--c-border);
    }
  }
</style>
