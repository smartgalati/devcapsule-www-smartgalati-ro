---
import { withBase } from '../lib/url';
import '../styles/global.css';
import PaletteInit from '../components/PaletteInit.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { t } from '../i18n';
import { STORAGE_KEY, paletteIds, defaultPalette } from '../lib/palettes';

interface Props {
  title: string;
  description: string;
  /** Absolute URL of a social image; optional. */
  image?: string;
}
const { title, description, image } = Astro.props;
const s = t();
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const paletteConfig = JSON.stringify({ key: STORAGE_KEY, ids: paletteIds, def: defaultPalette });
---

<!doctype html>
<html lang={s.lang} data-palette={defaultPalette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PaletteInit />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ro_RO" />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#172a47" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#continut">{s.skipToContent}</a>
    <Header />
    <main id="continut" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline data-palette-config={paletteConfig} set:html={`(function(){var c=JSON.parse(document.currentScript.getAttribute('data-palette-config'));var root=document.documentElement;function apply(v,save){if(c.ids.indexOf(v)<0)v=c.def;root.setAttribute('data-palette',v);document.querySelectorAll('[data-palette-select]').forEach(function(s){if(s.value!==v)s.value=v;});if(save){try{localStorage.setItem(c.key,v);}catch(e){}}}
apply(root.getAttribute('data-palette')||c.def,false);
document.querySelectorAll('[data-palette-select]').forEach(function(s){s.addEventListener('change',function(){apply(s.value,true);});});
window.addEventListener('storage',function(e){if(e.key===c.key&&e.newValue)apply(e.newValue,false);});})();`} />
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -100px;
    z-index: 100;
    background: var(--c-accent);
    color: #1b1408;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-sm);
    font-weight: 700;
  }
  .skip:focus {
    top: var(--s-4);
  }
  main:focus {
    outline: none;
  }
</style>
