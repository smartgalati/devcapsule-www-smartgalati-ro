---
/**
 * Click-to-reveal contact details. The HTML contains only reversed strings;
 * the plain phone/e-mail are assembled in the browser on demand. Limits: a
 * scraper that runs JavaScript, or reverses strings, can still recover them.
 */
import { site } from '../config/site';
import { t } from '../i18n';
const s = t();
---

<div class="reveal" data-reveal>
  <div class="reveal__item">
    <p class="reveal__label">{s.contact.phone}</p>
    <button class="btn btn--ghost" type="button" data-reveal-btn="phone" data-value={site.contact.phone}>
      {s.contact.revealPhone}
    </button>
    <p class="reveal__out" data-reveal-out="phone" aria-live="polite"></p>
  </div>
  <div class="reveal__item">
    <p class="reveal__label">{s.contact.email}</p>
    <button class="btn btn--ghost" type="button" data-reveal-btn="email" data-value={site.contact.email}>
      {s.contact.revealEmail}
    </button>
    <p class="reveal__out" data-reveal-out="email" aria-live="polite"></p>
  </div>
  <noscript><p class="note">{s.contact.noscript}</p></noscript>
</div>

<style>
  .reveal {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin-block: var(--s-4) var(--s-6);
  }
  .reveal__item {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: var(--s-5);
  }
  .reveal__label {
    margin: 0 0 var(--s-3);
    font-size: var(--fs-xs);
    font-weight: var(--fw-strong);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-2);
  }
  .reveal__out {
    margin: var(--s-3) 0 0;
    font-size: var(--fs-xl);
    font-weight: var(--fw-strong);
    overflow-wrap: anywhere;
  }
  .reveal__out:empty {
    display: none;
  }
</style>

<script>
  const decode = (v: string) => Array.from(v).reverse().join('');
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-reveal-btn]')) {
    btn.addEventListener('click', () => {
      const kind = btn.dataset.revealBtn!;
      const value = decode(btn.dataset.value || '');
      const out = document.querySelector<HTMLElement>(`[data-reveal-out="${kind}"]`)!;
      const a = document.createElement('a');
      a.textContent = value;
      a.href = kind === 'phone' ? `tel:${value.replace(/\s+/g, '')}` : `mailto:${value}`;
      out.replaceChildren(a);
      btn.hidden = true;
      a.focus();
    });
  }
</script>
